#!/bin/bash

# Get current working directory and define paths
CWD=$(dirname "$(readlink -f "$0")")
SIF_PATH=$(readlink -f "$CWD/../mcce4-alpha.sif")
CONTAINER_NAME="MCCE4-Alpha"
DOCKER_DIR=$(readlink -f "$CWD/../Docker")

# --- Function to display help ---
show_help() {
    echo "MCCE4-Alpha Execution Wrapper"
    echo "Usage: mc4 [OPTIONS] <COMMAND>"
    echo ""
    echo "Options:"
    echo "  -d          Enable Development Mode (runs via Docker)"
    echo "  -h, --help  Show this help message"
    echo ""
    echo "Examples:"
    echo "  mc4 step1.py -h         # Run via Apptainer (Production)"
    echo "  mc4 -d step2.py -h      # Run via Docker (Development)"
    echo "  mc4 -h                  # Show this help"
}

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

# DOCKER Mode
if [ "$1" == "-d" ]; then
    shift # Remove '-d' from the argument list
    
    # 1. Check if the container is running
    if ! docker ps --format '{{.Names}}' | grep -q "^${CONTAINER_NAME}$"; then
        echo "❌ Error: Docker container '$CONTAINER_NAME' is not running."
        echo ""
        echo "Current status of all containers:"
        docker container ls -a
        echo ""
        echo "💡 Tip: To fix this, try one of the following:"
        echo "   1. If the container is NOT listed: Run 'docker-compose up -d' in $DOCKER_DIR."
        echo "   2. If it IS listed but Exited:     Run 'docker start $CONTAINER_NAME' and then rerun this command."
        echo ""
        exit 1
    fi

    # 2. Check if arguments remain after removing -d
    if [ $# -eq 0 ]; then
        echo "❌ Error: No command provided for Docker mode."
        show_help
        exit 1
    fi
    
    echo "🛠️  Running in Docker Development Mode..."
    docker exec -it "$CONTAINER_NAME" "$@"

# Apptainer Mode (Default)
else
    # Verify the .sif file exists
    if [ ! -f "$SIF_PATH" ]; then
        echo "❌ Error: Apptainer image not found at $SIF_PATH"
        exit 1
    fi

    # Check for empty arguments
    if [ $# -eq 0 ]; then
        show_help
        exit 1
    fi

    echo "🚀 Running in Apptainer Production Mode..."
    apptainer exec "$SIF_PATH" "$@"
fi