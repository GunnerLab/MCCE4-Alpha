#!/bin/bash

# Get current working directory bin/ and define paths.
BIN_DIR=$(dirname "$(readlink -f "$0")")
PROJECT_ROOT_DIR=$(dirname "$BIN_DIR")
SIF_PATH=$(readlink -f "$BIN_DIR/mcce4-alpha.sif")

CONTAINER_PATH="/opt/MCCE4-Alpha" # Internal path where code lives inside the image
BIND_ARGS=""

show_help() {
    echo "MCCE4-Alpha CLI Tool"
    echo "Usage: mc4 [OPTIONS] <COMMAND>"
    echo ""
    echo "Options:"
    echo "  -d          Development Mode (Binds local code to container)"
    echo "  -h, --help  Show this help message"
    echo ""
    echo "Examples:"
    echo "  mc4 step1.py prot.pdb   # Production (Uses baked-in code)"
    echo "  mc4 -d step1.py         # Development (Uses local code)"
    echo "  mc4 -h                  # Show this help"
}

if [ ! -f "$SIF_PATH" ]; then
    echo "❌ Error: Apptainer image not found at $SIF_PATH"
    exit 1
fi

if [[ "$1" == "-h" || "$1" == "--help" ]]; then
    show_help
    exit 0
fi

if [ $# -eq 0 ]; then
    echo "❌ Error: No command provided."
    show_help
    exit 1
fi

if [ "$1" == "-d" ]; then
    shift # Remove '-d' from the argument list
    
    # 2. Check if arguments remain after removing -d
    if [ $# -eq 0 ]; then
        echo "❌ Error: No command provided after -d."
        show_help
        exit 1
    fi

    echo "🔧 Running in Apptainer Development Mode..."
    BIND_ARGS="--bind $PROJECT_ROOT_DIR:$CONTAINER_PATH"
fi

apptainer exec $BIND_ARGS "$SIF_PATH" "$@"